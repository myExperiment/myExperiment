<h2>
	<%= icon "review", nil, "Reviews", { :style => "vertical-align: middle;" }, "" -%>
	<span style="vertical-align: middle;">Reviews</span>
	<span class="count_text" style="vertical-align: middle;">(<%= reviewable.reviews.length %>)</span>
</h2>

<div class="reviewsBox">

	<% unless reviewable.reviews.empty? %>
		<% if false %>
			<ul class="sectionIcons">
				<li><%= icon('review', new_workflow_review_path(reviewable), nil, nil, 'Write your own Review') %></li>
			</ul>
		<% end %>
		<a name="reviews"></a>
		<%= render :partial => "reviews/table", :locals => { :reviewable => reviewable, :collection => reviewable.reviews } %>
	<% else %>
		<p><i>No reviews yet</i></p>
		<a name="reviews"></a>
		<p style="margin-top: 0.6em;">
		</p>
	<% end %>
	
</div>
